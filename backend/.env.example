# Copy this file to .env and fill in your own values
PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/synapse
# Atlas example (used in production on Render):
# MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/synapse?retryWrites=true&w=majority
JWT_SECRET=replace-with-a-long-random-string
# Comma-separated list of frontend URLs allowed to call the API
# (any http://localhost port is always allowed during development)
CLIENT_URL=http://localhost:3000
# In production, set it to your Vercel URL, e.g. https://synapse-yourname.vercel.app

# ---- AI agent (optional) ----
# Free key: https://aistudio.google.com/apikey
# Leave empty to use the built-in (non-AI) answers.
GEMINI_API_KEY=
# Any Gemini model that supports function calling
GEMINI_MODEL=gemini-3.8-flash
